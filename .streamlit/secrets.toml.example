# Copy to .streamlit/secrets.toml (git-ignored) and paste the same keys into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
# Every key is optional locally: without DATABASE_URL the app uses SQLite in data/app.db.

# Supabase -> Project settings -> Database -> Connection string -> "Session pooler" (IPv4)
DATABASE_URL = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Public URL of the deployed app (used for Stripe redirects and notification links)
APP_URL = "https://<your-app>.streamlit.app"

# Random string; signs the short-lived login token used after the Stripe redirect
APP_SECRET = "change-me-to-a-long-random-string"

# Stripe TEST mode only (sk_test_...). Price = recurring monthly price in RON for "Premium".
STRIPE_SECRET_KEY = "sk_test_..."
STRIPE_PRICE_ID = "price_..."

# Push notifications
NTFY_BASE_URL = "https://ntfy.sh"

# Team account that can publish rule versions from the app
ADMIN_EMAIL = "team@example.com"
ADMIN_PASSWORD = "change-me"

# Demo account password (login: demo@prosumer.demo)
DEMO_PASSWORD = "demo1234"
