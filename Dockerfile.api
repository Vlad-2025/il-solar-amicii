# Mobile API. Hugging Face Spaces (Docker SDK): rename to Dockerfile in the Space repo, or point the Space at it.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-ron tesseract-ocr-eng poppler-utils libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt
COPY . .

# Hugging Face Spaces expects port 7860
ENV PORT=7860 PYTHONUNBUFFERED=1
EXPOSE 7860
CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips="*"
